# Vercel / Next.js (public)
# The Convex HTTP Actions base URL (*.convex.site) is DERIVED from this at
# runtime by lib/telegram/client.ts — do not add NEXT_PUBLIC_CONVEX_SITE_URL as
# a second source of truth. `convex deploy --cmd` injects this at build time on
# Vercel, so it is not set manually there either.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_PRIVY_APP_ID=
# Public @handle for the "Open bot" link on Tabs home. Without it that link is
# simply absent — it is never rendered pointing at a bot nobody registered.
# The bot's *token* is Convex-only and never belongs behind NEXT_PUBLIC_.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Vercel / Next.js (server — never NEXT_PUBLIC_)
CONVEX_DEPLOY_KEY=
CONVEX_DEPLOYMENT=dev:your-deployment

# Convex Cloud secrets — configure in Convex dashboard, not here (AD-19)
# PRIVY_APP_ID=                          # Privy app id for convex/auth.config.ts applicationID
# PRIVY_VERIFICATION_KEY=                # Privy app ES256 public verification key (PEM) → JWKS data URI
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_MINIAPP_NAME=
# TELEGRAM_MINIAPP_URL=                   # HTTPS Mini App origin (Menu button, DM web_app)
# PRIVY_APP_SECRET=
# DFLOW_API_KEY=
# AI_GATEWAY_API_KEY=                    # Convex-only (D-32). Receipt extraction via
#                                        # Vercel AI Gateway. Never set a value here.
#                                        # Never NEXT_PUBLIC_. Never copy onto Vercel.
# OPENAI_API_KEY=                        # deprecated; extraction uses AI_GATEWAY_API_KEY
# SOLANA_RPC_URL=
# OPERATOR_RECONCILIATION_SECRET=        # Convex-only (D-30). Gates GET
#                                        # /reconciliation on the .site host.
#                                        # Never NEXT_PUBLIC_. Never copy onto Vercel.
# KIE_API_KEY=                           # Convex-only (U-8). One-shot tab-card
#                                        # still via Kie Nano Banana 2. Never a value
#                                        # here. Never NEXT_PUBLIC_.
# JUPITER_API_KEY=                       # optional; token metadata falls back to
#                                        # the keyless lite tier without it, but
#                                        # that tier is slated for eventual
#                                        # retirement — set a free key from
#                                        # portal.jup.ag before mainnet.
